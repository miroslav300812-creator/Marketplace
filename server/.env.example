# ---------- Core ----------
PORT=4000
DATABASE_URL="file:./dev.db"
# Long random string; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-please
ADMIN_PASSWORD=admin
PUBLIC_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# ---------- Integrations ----------
# Leave empty to use the built-in mocks. Fill in to switch each service to its real API.

# LiqPay — merchant keys from https://www.liqpay.ua/ (Кабинет → Настройки → API)
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# 1 = sandbox payments (no real money), 0 = live
LIQPAY_SANDBOX=1

# Nova Poshta — API key from https://new.novaposhta.ua/ (Настройки → Безопасность → API ключ)
NOVAPOSHTA_API_KEY=
# Ref of the city you ship from (default: Kyiv)
NOVAPOSHTA_SENDER_CITY_REF=8d5a980d-391c-11dd-90d9-001a92567626

# SMS Fly — API key from https://sms-fly.ua/ ; sender name must be registered with them
SMSFLY_API_KEY=
SMSFLY_SENDER=InfoCenter
